<h1 style="
    font-family: Arial, sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: #4e8df5;
    margin: 0 0 18px 0;
    text-align: center;
">
    Greetings, {{name}}!
</h1>

<p style="
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333;
    margin: 0 0 20px 0;
    text-align: center;
">
    Welcome to our website!
</p>

<div style="text-align:center; margin-top: 30px;">
    <a href="https://your-frontend.com/login"
       style="
            background: #4e8df5;
            color: white;
            padding: 14px 28px;
            font-family: Arial, sans-serif;
            font-size: 16px;
            text-decoration: none;
            border-radius: 6px;
            display: inline-block;
       ">
        Enter to account
    </a>
</div>

<p style="
    font-family: Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #777;
    margin-top: 40px;
    text-align: center;
">
    If you did not sign up, ignore this message.
</p>
